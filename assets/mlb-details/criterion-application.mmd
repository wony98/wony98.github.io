flowchart TD
    PROBLEM["발견한 문제<br/>비슷한 기준을 찾았다는 사실만으로는<br/>오늘 그 기준을 적용해도 되는지 알 수 없음"]

    subgraph USED["1. 실제 사용 경로: 과거 판단 사례를 참고로 제공"]
        CASES[("과거 경기의 판단 사례 모음<br/>대상일 이전 사례만 사용")]
        FEATURES["상황 특징으로 유사 사례 검색<br/>선발 폼·타선·불펜·환경 비교<br/>승패와 총득점 사례를 따로 선택"]
        REFERENCE["적용성 표시와 참고 사례 구성<br/>상황이 다른 경우 반례·부적용 표시"]
        INJECT["네레이터 판단기준 섹션<br/>경기별 메모장·보조 문맥에 연결"]
        REASON["LLM이 당일 양 팀 근거와 함께 검토<br/>과거 사례를 참고자료로 제공"]
        CASES --> FEATURES --> REFERENCE --> INJECT --> REASON
    end
    PROBLEM --> USED

    EARLY_GATE["초기 연구의 별도 승패 보류 처리<br/>선택한 팀 선발의 붕괴 위험이 더 크고<br/>지지하는 가까운 사례가 없으면 승패 선택을 강제 보류"]
    CASES -.->|"초기 승패 보류 처리에도 사용"| EARLY_GATE

    subgraph RETRIEVE["2. 후기 검색 모듈 연구: 조건과 당일 근거 연결"]
        BANK[("과거 경기 판단기준 은행<br/>조건 · 무효화 조건 · 출처 경기·날짜")]
        CUT["대상 경기보다 이전 자료만 선별<br/>대상 경기 자신과 같은 날·후대 기준 제외"]
        TODAY["대상 경기의 사전 근거<br/>선수·역할별 값과 비교 항목"]
        MATCH["조건의 의미에 맞춰 근거 연결<br/>과거 근거 번호를 그대로 복사하지 않고<br/>오늘 경기의 근거 번호·값에 다시 연결"]
        CANDIDATE[("검색 후보와 연결 상태 저장<br/>연결 불가·결측은 불명으로 표시<br/>검색 순위가 최종 방향을 정하지 않음")]
        BANK --> CUT --> MATCH
        TODAY --> MATCH --> CANDIDATE
    end
    PROBLEM --> RETRIEVE

    subgraph APPLY["3. 별도 단계별 판정 연구: 당일 근거로 적용 여부 판단"]
        FROZEN["해당 실험의 고정 입력<br/>이미 선택된 과거 기준 + 당일 근거 원장"]
        CONDITIONS["LLM이 기준별 조건 대조<br/>필수조건: 충족 / 실패 / 불명<br/>무효화 조건: 발동 / 없음 / 불명"]
        STATUS[("기준 적용 기록 JSON<br/>적용 / 약화 / 무효 / 자료 부족<br/>각 판단을 당일 근거 ID로 설명")]
        PATH["양쪽 경로를 따로 구성<br/>양 팀 승리 가능 과정<br/>총득점 증가·억제 과정"]
        CONFLICT[("충돌 원장 저장<br/>반대 근거와 무효 조건을 처리한 이유<br/>남아 있는 불확실성")]
        FINAL["LLM 최종 비교<br/>승패와 총득점을 별도로 판단<br/>반대편보다 선택한 방향을 지지하는 이유"]
        AUDIT["근거·조건 처리 검사<br/>누락·중복·알 수 없는 참조 점검<br/>검사 실패 기록 보존"]
        FROZEN --> CONDITIONS --> STATUS --> PATH --> CONFLICT --> FINAL --> AUDIT
    end
    PROBLEM --> APPLY

    BOUNDARY["실제 참고 사례 사용과 후기 연구를 구분<br/>2·3번 연구 모듈을 하나로 자동 연결한<br/>운영 실행기가 있었다는 뜻은 아님"]
    LIMIT["판단기준은 참고할 판단 절차이지 정답표가 아님<br/>조건·반론을 드러내는 구현과<br/>일관된 판정·예측력 입증은 구분"]
    CANDIDATE --> BOUNDARY
    AUDIT --> BOUNDARY --> LIMIT
    REASON --> LIMIT
    EARLY_GATE --> LIMIT

